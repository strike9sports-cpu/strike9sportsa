rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /company_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /expense_categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    match /shareholders/{shareholderId} {
      allow read: if true;
      allow write: if true;
    }

    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if true;
    }

    match /revenues/{revenueId} {
      allow read: if true;
      allow write: if true;
    }

    match /settlements/{settlementId} {
      allow read: if true;
      allow write: if true;
    }

    match /audit_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
